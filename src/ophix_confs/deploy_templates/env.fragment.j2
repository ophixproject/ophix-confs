# ---------------------------------------------------------------------------
# ophix-confs — Configuration snippets plugin
# ---------------------------------------------------------------------------

# Show the Configuration Formats model in the admin navigation.
#
# Configuration Formats define the supported file types (json, yaml, xml, ini,
# toml, env, raw) along with their MIME types, validators, and CodeMirror
# syntax highlighting modes. The initial set is seeded automatically on first
# migrate and rarely needs manual intervention.
#
# Set to True only if you need to add custom formats, disable a built-in
# format, or inspect format metadata. Leave False for normal operation.
#
# Valid values: True, False
# Default: False
SHOW_CONFIG_FORMATS_MODEL=False
